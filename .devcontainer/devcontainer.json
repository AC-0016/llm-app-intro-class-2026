{
  "name": "LLMアプリケーション開発 2026",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r requirements-dev.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "MS-CEINTL.vscode-language-pack-ja",
        "marp-team.marp-vscode",
        "ms-vsliveshare.vsliveshare"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "授業資料アシスタント", "onAutoForward": "openBrowser", "visibility": "private"}
  },
  "remoteUser": "vscode"
}
